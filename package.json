{
  "name": "pt-depiler",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "homepage": "https://github.com/4Nest/PT-depiler",
  "packageManager": "pnpm@12.10.1",
  "author": {
    "name": "Pt-Plugins",
    "url": "https://github.com/pt-plugins"
  },
  "maintainers": [
    {
      "name": "Rhilip",
      "url": "https://github.com/Rhilip"
    }
  ],
  "contributors": [
    {
      "name": "ronggang",
      "url": "https://github.com/ronggang"
    },
    {
      "name": "ted423",
      "url": "https://github.com/ted423"
    }
  ],
  "scripts": {
    "dev": "vite dev",
    "format": "prettier --list-different -w ./",
    "check": "vue-tsc --noEmit && tsx vite/scripts/checkSiteDefinition.ts",
    "check:site-definition": "tsx vite/scripts/checkSiteDefinition.ts",
    "build:dist": "vite build",
    "build:dist-firefox": "cross-env TARGET=firefox vite build",
    "build:watch": "vite build --watch --mode development --minify false",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=23.7.0",
    "pnpm": ">=12.0.0"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@vueuse/components": "^15.0.0",
    "@vueuse/core": "^15.0.0",
    "@webext-core/job-scheduler": "^3.0.0",
    "@webext-core/messaging": "^4.0.1",
    "@webext-core/storage": "^2.0.0",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "es-toolkit": "^1.53.1",
    "fflate": "^0.8.3",
    "filesize": "^11.0.29",
    "idb": "^8.0.4",
    "lucide-vue-next": "^1.0.0",
    "nanoid": "^6.0.2",
    "p-queue": "^10.0.0",
    "parse-torrent": "^11.0.24",
    "pinia": "^4.1.0",
    "pinia-plugin-state-persistence": "^1.12.20",
    "reka-ui": "^2.11.0",
    "search-query-parser": "^1.6.0",
    "sizzle": "^2.3.10",
    "tailwind-merge": "^3.7.0",
    "url-join": "^6.0.0",
    "valid-filename": "^5.0.0",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "webdav": "^5.11.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/parse-torrent": "^11.0.1",
    "@types/sizzle": "^2.3.10",
    "@vitejs/plugin-vue": "^6.0.10",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.7",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-web-extension": "4.5.1",
    "vue-tsc": "3.3.13"
  },
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "vueIndentScriptAndStyle": false,
    "endOfLine": "lf"
  },
  "lint-staged": {
    "*.{js,ts,json,vue,html,css,scss}": [
      "prettier --write "
    ]
  }
}
